[submodule ".registry"]
	path = .registry
	url = https://github.com/paws-r/paws-r.r-universe.dev
	branch = HEAD
[submodule "awscrt"]
	path = awscrt
	url = https://github.com/paws-r/aws-crt-r
[submodule "paws"]
	path = paws
	url = https://github.com/paws-r/paws
	subdir = cran/paws
[submodule "paws.analytics"]
	path = paws.analytics
	url = https://github.com/paws-r/paws
	subdir = cran/paws.analytics
